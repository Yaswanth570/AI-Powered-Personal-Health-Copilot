# Backend environment configuration
# Keep secrets strictly in backend/.env (which is gitignored). Never commit keys or real credentials.

# Container / Server listening port (default: 10000 in Dockerfile / local dev 8000)
# PORT=10000

# Maximum upload size in bytes (default: 10 MB)
# MAX_UPLOAD_BYTES=10485760

# CORS settings for frontend access.
# CORS_ORIGINS: Comma-separated list of allowed origins (e.g. your Vercel production domain).
# Localhost dev ports (5173-5175) remain automatically supported.
# CORS_ORIGINS=https://ai-powered-personal-health-copilot.vercel.app,http://localhost:5173
# CORS_ORIGIN_REGEX: Optional regex pattern for preview deployments (e.g. Vercel PR previews).
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# OCR settings (used by /api/documents/extract-text-ocr)
# Maximum number of PDF pages that OCR will process (default: 20)
# OCR_MAX_PAGES=20
# DPI used when rendering PDF pages for OCR (default: 200, max: 400)
# OCR_DPI=200
# Comma-separated Tesseract language codes (default: eng)
# OCR_LANGUAGES=eng

# Gemini AI configuration (used by /api/documents/analyze-ai and /api/patients/{id}/chat)
# Get your API key from Google AI Studio: https://aistudio.google.com/
# Keep this key strictly on the backend. Never expose it to the frontend or commit to git.
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.1-flash-lite
# Supported models: gemini-3.1-flash-lite (default), gemini-3.5-flash-lite, gemini-3.8-flash
# Maximum characters of document text accepted for AI analysis (default: 150000)
# MAX_AI_TEXT_CHARS=150000

# Database configuration (PostgreSQL)
# Format: postgresql+psycopg://username:password@hostname:5432/databasename
# Also accepts standard postgresql:// or postgres:// connection strings from providers
# such as Supabase, Neon, AWS RDS, Render, or Railway (auto-normalized to psycopg3).
# When DATABASE_URL is unset, a local development SQLite fallback is used (sqlite:///./health_copilot.db).
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/health_copilot
