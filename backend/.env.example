# Backend environment configuration
# No secrets are required for this milestone.

# Maximum upload size in bytes (default: 10 MB)
# MAX_UPLOAD_BYTES=10485760

# Comma-separated list of allowed CORS origins for the frontend.
# Defaults cover common Vite dev ports (5173-5175).
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OCR settings (used by /api/documents/extract-text-ocr)
# Maximum number of PDF pages that OCR will process (default: 20)
# OCR_MAX_PAGES=20
# DPI used when rendering PDF pages for OCR (default: 200, max: 400)
# OCR_DPI=200
# Comma-separated Tesseract language codes (default: eng)
# OCR_LANGUAGES=eng

# Gemini AI configuration (used by /api/documents/analyze-ai)
# Get your API key from Google AI Studio: https://aistudio.google.com/
# Keep this key strictly on the backend. Never expose it to the frontend or commit to git.
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.1-flash-lite
# Supported models: gemini-3.1-flash-lite (recommended, fast & stable), gemini-3.5-flash-lite, gemini-3.8-flash
# Maximum characters of document text accepted for AI analysis (default: 150000)
# MAX_AI_TEXT_CHARS=150000

# PostgreSQL Database configuration (used by Step 6 persistence)
# Format: postgresql+psycopg://username:password@localhost:5432/health_copilot
# When DATABASE_URL is unset, a local development SQLite fallback is used (sqlite:///./health_copilot.db).
# Keep credentials strictly in backend/.env (which is gitignored).
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/health_copilot
