# Frontend environment configuration
# Copy this file to .env.local (gitignored) for local development or configure in Vercel project settings.

# Backend API Base URL (FastAPI):
# For local development: http://localhost:8000
# For production deployment: https://your-backend-service.onrender.com
# Defaults to http://localhost:8000 when unset. Trailing slashes are automatically handled.
VITE_API_BASE_URL=http://localhost:8000
